{
  "name": "camino-de-estudio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "App de estudio offline (PWA) para 2.º de Primaria. Sin cuentas, sin analítica.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "validate:content": "vitest run src/content",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "1.56.1",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.2.4",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "6.4.1",
    "vite-plugin-pwa": "1.1.0",
    "vitest": "3.2.4",
    "workbox-window": "7.3.0"
  }
}
